model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DimDate","DimStage","DimSource","DimRejectReason","DimRecruiter","DimJob","FactRequisition","FactApplication","FactStageEvent","DataFolderPath"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table DimDate
ref table DimStage
ref table DimSource
ref table DimRejectReason
ref table DimRecruiter
ref table DimJob
ref table FactRequisition
ref table FactApplication
ref table FactStageEvent
ref table _Measures

ref cultureInfo en-US

